# ============================================
# Django Configuration
# ============================================
SECRET_KEY=your-super-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,*.onrender.com

# Database
# Local: SQLite for development
DATABASE_URL=sqlite:///db.sqlite3
# Production: PostgreSQL on Render
# DATABASE_URL=postgresql://user:password@host:5432/database

# ============================================
# M-Pesa Configuration (Daraja API)
# ============================================
MPESA_SANDBOX=True  # Set to False in production
MPESA_CONSUMER_KEY=your_consumer_key_from_daraja
MPESA_CONSUMER_SECRET=your_consumer_secret_from_daraja
MPESA_BUSINESS_SHORTCODE=your_paybill_number
MPESA_PASSKEY=your_stk_push_passkey

# Callback URL (must be HTTPS and publicly accessible)
MPESA_CALLBACK_URL=https://yourdomain.com/api/mpesa/callback/

# ============================================
# Email Configuration (Gmail)
# ============================================
EMAIL_HOST_USER=keptoinvestor@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password  # Use Gmail App Password, not regular password
ADMIN_EMAIL=keptoinvestor@gmail.com  # Admin email for approval requests

# ============================================
# SMS Configuration (Twilio)
# ============================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890  # Your Twilio phone number

# ============================================
# CORS Configuration
# ============================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,https://yourdomain.com

# ============================================
# Render Deployment (if using Render)
# ============================================
RENDER_EXTERNAL_HOSTNAME=your-app-name.onrender.com
